o Cube

# --- Vertex positions (v) ---
# 8 unique vertices of a cube
v  1.0 -1.0 -1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v  1.0  1.0 -1.0

v -1.0 -1.0  1.0
v -1.0 -1.0 -1.0
v -1.0  1.0 -1.0
v -1.0  1.0  1.0


# --- Texture coordinate (vt) ---
# 0..1 UV square per face
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# --- Vertex normals (vn) ---
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0

# --- Faces (f  v/vt/vn) ---
# +X
f 1/1/1 2/2/1 3/3/1
f 1/1/1 3/3/1 4/4/1
# -X
f 5/1/2 6/2/2 7/3/2
f 5/1/2 7/3/2 8/4/2
# +Y
f 7/1/3 4/2/3 3/3/3
f 7/1/3 3/3/3 8/4/3
# -Y
f 5/1/4 2/2/4 1/3/4
f 5/1/4 1/3/5 6/4/4
# +Z
f 5/1/5 2/2/5 3/3/5
f 5/1/5 3/3/5 8/4/5
# -Z
f 1/1/6 6/2/6 7/3/6
f 1/1/6 7/3/6 4/4/6